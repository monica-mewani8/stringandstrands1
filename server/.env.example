# Supabase (service role — NEVER expose to frontend/client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# Shiprocket
SHIPROCKET_EMAIL=your-shiprocket-email@example.com
SHIPROCKET_PASSWORD=your-shiprocket-password

# Resend (email service)
RESEND_API_KEY=re_your_resend_api_key

# Owner notification email
OWNER_EMAIL=owner@stringsandstrands.com

# Frontend URL (for CORS — change to your production domain when deploying)
FRONTEND_URL=http://localhost:5173

# Port
PORT=3001
