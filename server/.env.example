# Supabase (service role — NEVER expose to frontend/client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# Shiprocket
SHIPROCKET_EMAIL=your-shiprocket-email@example.com
SHIPROCKET_PASSWORD=your-shiprocket-password

# Gmail (Nodemailer — use a Gmail App Password, NOT your account password)
# Enable 2FA then generate an App Password at: myaccount.google.com/apppasswords
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Owner notification email (receives a copy of every order)
OWNER_EMAIL=kajorganicsofficial@gmail.com

# Frontend URL (for CORS — change to your production domain when deploying)
FRONTEND_URL=http://localhost:5174

# Port
PORT=3001
